default_platform(:android)

platform :android do
  lane :beta do
    gradle(
      task: "assembleDebug"
    )

    apk_path = Dir["app/build/outputs/apk/debug/*.apk"].first

    UI.user_error!("APK not found!") unless apk_path

    tag = ENV["GITHUB_REF_NAME"] || "local"
    new_apk_path = "app/build/outputs/apk/debug/news-#{tag}.apk"

    sh("mv #{apk_path} #{new_apk_path}")

    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID"],
      testers: "naimishgupta983842377@gmail.com",
      apk_path: new_apk_path
    )

    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID"],
      testers: "naimishgupta983842377@gmail.com",
      apk_path: new_apk_path
    )
  end
end