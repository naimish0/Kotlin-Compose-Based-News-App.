default_platform(:android)

platform :android do
  lane :beta do
    gradle(
      task: "assembleDebug"
    )

    tag = ENV["GITHUB_REF_NAME"] || "local"

    sh <<~SHELL
      mv app/build/outputs/apk/debug/ \
         app/build/outputs/apk/debug/news-#{tag}.apk
    SHELL

    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID"],
      testers: "naimishgupta983842377@gmail.com",
      apk_path: "app/build/outputs/apk/debug/news-#{tag}.apk"
    )
  end
end